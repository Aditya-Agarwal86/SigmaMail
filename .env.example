# CampusInbox Environment Variables

# --- Application Configuration ---
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Allowed college email domains (comma-separated list for configurability)
ALLOWED_EMAIL_DOMAINS="vitapstudent.ac.in"

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://campusinbox_user:campusinbox_password@localhost:5432/campusinbox_db?schema=public"

# --- Session Authentication (Auth.js / NextAuth.js v5) ---
# Secret for signing session cookies / JWTs (e.g. `openssl rand -base64 32`)
AUTH_SECRET="your-32-character-random-auth-secret-here"

# Base Google OAuth credentials (used for profile identity & domain check)
# Scopes requested at sign-in: openid, email, profile
AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# --- Separate Gmail Integration OAuth Credentials ---
# Can use the same client credentials or dedicated credentials
# Scopes: https://www.googleapis.com/auth/gmail.readonly, https://www.googleapis.com/auth/gmail.modify
GMAIL_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="your-google-oauth-client-secret"
GMAIL_REDIRECT_URI="http://localhost:3000/api/auth/gmail/callback"

# AES-256-GCM Token Encryption Key for Storing Refresh/Access Tokens at Rest
# Must be exactly 32 bytes hex encoded (64 hex characters) or base64 (e.g. `openssl rand -hex 32`)
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# --- Optional AI Service Integration ---
# Provider options: "gemini" | "openai" | "disabled"
AI_PROVIDER="gemini"
AI_API_KEY="your-gemini-or-openai-api-key"
AI_MODEL_CLASSIFICATION="gemini-1.5-flash"
AI_MODEL_SUMMARIZATION="gemini-1.5-flash"
# Hard daily cost / token limit cap per user (in USD or estimated token counts)
AI_MAX_DAILY_TOKENS_PER_USER="50000"

# --- Rate Limiting & Queue (Redis / In-Memory) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
